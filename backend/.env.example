# MQTT broker (isolated Docker lab)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=campus/lab1

# LLM provider: openai | local
LLM_PROVIDER=openai

# Used when LLM_PROVIDER=openai (OpenAI-compatible provider, e.g. OpenRouter)
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_MODEL=openrouter/free
ROUTER_API_KEY=your-router-api-key

# Used only when LLM_PROVIDER=local (OpenAI-compatible endpoint)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=30

# Persistence
DB_PATH=backend/data/watchdog.db

# Frontend dev origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Correlation window
WINDOW_SECONDS=60
