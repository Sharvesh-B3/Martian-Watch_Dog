# MQTT broker (isolated Docker lab)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=campus/lab1

# Final MVP uses fully local reasoning through Ollama.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Optional cloud adapter kept for provider flexibility; unused by the final MVP.
# To use it, set LLM_PROVIDER=gemini and provide a real key outside Git.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Isolated network containment gateway
GATEWAY_CONTROL_URL=http://127.0.0.1:9000
GATEWAY_TIMEOUT_SECONDS=5

# Persistence
DB_PATH=backend/data/watchdog.db

# Frontend dev origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Correlation window
WINDOW_SECONDS=60
