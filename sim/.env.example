# Generated values belong in sim/.env, which is ignored by Git.
# Do not use placeholder or shared passwords. Run sim/setup_credentials.py once Docker is available.

# Container MQTT remains 1883; host access uses 1884 to avoid a native broker on 1883.
MQTT_HOST_PORT=1884

MQTT_SMART_LOCK_USERNAME=device_smart_lock_01
MQTT_SMART_LOCK_PASSWORD=

MQTT_RFID_SCANNER_USERNAME=device_rfid_scanner_01
MQTT_RFID_SCANNER_PASSWORD=

MQTT_AIR_QUALITY_USERNAME=device_air_quality_01
MQTT_AIR_QUALITY_PASSWORD=

MQTT_POWER_METER_USERNAME=device_power_meter_01
MQTT_POWER_METER_PASSWORD=

MQTT_DECOY_TWIN_USERNAME=device_decoy_twin_01
MQTT_DECOY_TWIN_PASSWORD=

MQTT_ATTACK_CONTROLLER_USERNAME=attack_controller
MQTT_ATTACK_CONTROLLER_PASSWORD=

MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=

MQTT_OBSERVER_USERNAME=observer
MQTT_OBSERVER_PASSWORD=

# Optional host/shell overrides. Compose already defaults to these deterministic seeds.
# Set an individual value to "random" in the invoking shell for nondeterministic telemetry.
SMART_LOCK_SIM_SEED=101
RFID_SCANNER_SIM_SEED=102
AIR_QUALITY_SIM_SEED=103
POWER_METER_SIM_SEED=104
DECOY_TWIN_SIM_SEED=105
