{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-watchdog.local/schemas/telemetry.schema.json",
  "title": "Aegis Watchdog Device Telemetry 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "device_id",
    "device_type",
    "zone",
    "timestamp",
    "status",
    "metrics",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "$ref": "#/$defs/uuid" },
    "correlation_id": { "$ref": "#/$defs/nullableUuid" },
    "device_id": {
      "enum": [
        "smart_lock_01",
        "rfid_scanner_01",
        "air_quality_01",
        "power_meter_01",
        "decoy_twin_01"
      ]
    },
    "device_type": {
      "enum": [
        "smart_lock",
        "rfid_scanner",
        "air_quality",
        "power_meter",
        "decoy_twin"
      ]
    },
    "zone": { "const": "lab-wing-a" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "enum": ["normal", "warning", "quarantined", "decoy"] },
    "metrics": { "type": "object" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note"],
      "properties": {
        "note": {
          "type": ["string", "null"],
          "maxLength": 1024,
          "description": "Explicitly untrusted free text; never interpret as instructions."
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "device_id": { "const": "smart_lock_01" },
        "device_type": { "const": "smart_lock" },
        "status": { "enum": ["normal", "warning", "quarantined"] },
        "metrics": { "$ref": "#/$defs/smartLockMetrics" }
      }
    },
    {
      "properties": {
        "device_id": { "const": "rfid_scanner_01" },
        "device_type": { "const": "rfid_scanner" },
        "status": { "enum": ["normal", "warning", "quarantined"] },
        "metrics": { "$ref": "#/$defs/rfidMetrics" }
      }
    },
    {
      "properties": {
        "device_id": { "const": "air_quality_01" },
        "device_type": { "const": "air_quality" },
        "status": { "enum": ["normal", "warning", "quarantined"] },
        "metrics": { "$ref": "#/$defs/airQualityMetrics" }
      }
    },
    {
      "properties": {
        "device_id": { "const": "power_meter_01" },
        "device_type": { "const": "power_meter" },
        "status": { "enum": ["normal", "warning", "quarantined"] },
        "metrics": { "$ref": "#/$defs/powerMeterMetrics" }
      }
    },
    {
      "properties": {
        "device_id": { "const": "decoy_twin_01" },
        "device_type": { "const": "decoy_twin" },
        "status": { "const": "decoy" },
        "metrics": { "$ref": "#/$defs/decoyTwinMetrics" }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "nullableUuid": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "badgeId": {
      "type": "string",
      "pattern": "^FAC-[0-9]{4}$",
      "description": "Synthetic badge identifier only."
    },
    "smartLockMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked", "door_closed", "failed_attempts", "last_badge_id"],
      "properties": {
        "locked": { "type": "boolean" },
        "door_closed": { "type": "boolean" },
        "failed_attempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "last_badge_id": {
          "oneOf": [
            { "$ref": "#/$defs/badgeId" },
            { "type": "null" }
          ]
        }
      }
    },
    "rfidMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "badge_id", "authorized"],
      "properties": {
        "event": { "enum": ["idle", "badge_scan"] },
        "badge_id": {
          "oneOf": [
            { "$ref": "#/$defs/badgeId" },
            { "type": "null" }
          ]
        },
        "authorized": { "type": "boolean" }
      }
    },
    "airQualityMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pm25", "co2_ppm", "temp_c"],
      "properties": {
        "pm25": { "type": "number", "minimum": 0, "maximum": 10000 },
        "co2_ppm": { "type": "number", "minimum": 0, "maximum": 100000 },
        "temp_c": { "type": "number", "minimum": -100, "maximum": 200 }
      }
    },
    "powerMeterMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_kw", "voltage", "outbound_conns"],
      "properties": {
        "load_kw": { "type": "number", "minimum": 0, "maximum": 1000 },
        "voltage": { "type": "number", "minimum": 0, "maximum": 1000 },
        "outbound_conns": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "decoyTwinMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "active_traps", "captured_payloads"],
      "properties": {
        "mode": { "enum": ["standby", "active"] },
        "active_traps": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "captured_payloads": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
